---
import { company } from '../data/company';
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import Icon from './Icon.astro';
---

<nav
  transition:name="site-mobile-bar"
  aria-label="Ações rápidas"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-white/10 bg-ink-900/95 px-3 pt-3 backdrop-blur-md [padding-bottom:max(0.75rem,env(safe-area-inset-bottom))] md:hidden"
>
  <a
    href={buildWhatsAppLink(GENERAL_MESSAGE)}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex min-h-12 items-center justify-center gap-2 rounded-[12px] bg-brand-500 px-4 font-bold text-ink-900"
  >
    <Icon name="whatsapp" class="size-5" />
    <span>WhatsApp</span>
  </a>
  <a
    href={company.phoneHref}
    class="inline-flex min-h-12 items-center justify-center gap-2 rounded-[12px] border border-white/25 px-4 font-bold text-white"
  >
    <Icon name="phone" class="size-5" />
    <span>Ligar</span>
  </a>
</nav>
