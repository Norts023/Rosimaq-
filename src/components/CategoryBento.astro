---
import { Picture } from 'astro:assets';
import { categories, equipment } from '../data/equipment';
import { photoFor } from '../lib/photos';

// Foto representativa de cada categoria (nome do arquivo em equipment.ts).
const hero: Record<string, string> = {
  concreto: '01_Betoneira_Menegotti_Prime_400L_220V.jpg',
  'demolicao-perfuracao': '02_Martelete_Rompedor_Arita_5kg_1300W_220V.jpg',
  'altura-acesso': '06_Andaime_Profissional_Aco_1,00x1,00_NR18.jpg',
  eletrica: '08_Extensao_Eletrica_50m_20A_Cabo_PP_2x1,5.jpg',
  pintura: '13_Maquina_de_Pintura_Menegotti.jpg',
};
const count = (slug: string) => equipment.filter((item) => item.category === slug).length;
const plural = (n: number) => (n === 1 ? '1 item' : `${n} itens`);
---

<section
  class="mx-auto max-w-[1200px] px-4 py-[clamp(4rem,10vw,8rem)] md:px-6"
  aria-labelledby="categorias-title"
>
  <div class="mb-10 flex flex-col gap-3">
    <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-ink-500">Catálogo</p>
    <!-- APROVAR TEXTO -->
    <h2 id="categorias-title" class="condensed text-[clamp(1.75rem,3.5vw,2.75rem)] font-extrabold">
      O que você precisa na obra
    </h2>
  </div>
  <ul class="grid auto-rows-[220px] gap-4 md:grid-cols-3 md:auto-rows-[260px]">
    {categories.map((category, i) => (
      <li
        class:list={['group', i === 0 && 'md:col-span-2 md:row-span-2', i === 3 && 'md:col-span-2']}
        data-reveal
      >
        <a
          href={`/equipamentos?categoria=${category.slug}`}
          class="relative flex h-full flex-col justify-between overflow-hidden rounded-[12px] border border-ink-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_-20px_rgba(0,0,0,.35)] focus-visible:outline-brand-500"
        >
          <Picture
            src={photoFor(hero[category.slug] ?? '')}
            formats={['avif', 'webp']}
            alt=""
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 33vw, 100vw"
            loading="lazy"
            class="absolute inset-0 -z-0 h-full w-full object-contain p-10 transition-transform duration-500 group-hover:scale-[1.04]"
          />
          <span class="relative z-10 inline-flex w-fit rounded-[999px] bg-ink-900 px-3 py-1 text-xs font-semibold text-brand-300">
            {plural(count(category.slug))}
          </span>
          <span class="relative z-10 mt-auto flex items-end justify-between gap-4 rounded-[12px] bg-white/90 p-3 backdrop-blur-sm">
            <span class="condensed text-xl font-extrabold text-ink-900">{category.label}</span>
            <span class="text-sm font-semibold text-ink-900 group-hover:underline">Ver</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
