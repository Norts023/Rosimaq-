---
import { withBase } from '../lib/url';
import { featuredEquipment } from '../data/equipment';
import EquipmentCard from './EquipmentCard.astro';
---

<section class="bg-ink-50 py-[clamp(4rem,10vw,8rem)]" aria-labelledby="destaques-title">
  <div class="mx-auto max-w-[1200px] px-4 md:px-6">
    <div class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div class="flex flex-col gap-3">
        <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-ink-500">
          Destaques
        </p>
        <!-- APROVAR TEXTO -->
        <h2
          id="destaques-title"
          class="condensed text-[clamp(1.75rem,3.5vw,2.75rem)] font-extrabold"
        >
          Os mais pedidos nas obras
        </h2>
      </div>
      <a
        href={withBase('/equipamentos')}
        class="inline-flex min-h-11 items-center font-semibold text-ink-900 underline decoration-brand-500 decoration-2 underline-offset-4 hover:decoration-4"
      >
        Ver catálogo completo
      </a>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {featuredEquipment.map((item, i) => (
        <li data-reveal>
          <EquipmentCard item={item} eager={i === 0} />
        </li>
      ))}
    </ul>
  </div>
</section>
