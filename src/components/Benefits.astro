---
import Icon from './Icon.astro';

const items = [
  {
    icon: 'shield' as const,
    title: 'Qualidade nos equipamentos',
    text: 'Máquinas revisadas e prontas para o uso.',
  },
  {
    icon: 'box' as const,
    title: 'Segurança na sua obra',
    text: 'Andaimes e acessórios alinhados à NR18.',
  },
  {
    icon: 'chat' as const,
    title: 'Atendimento personalizado',
    text: 'Fale direto com a equipe, sem robô.',
  },
  {
    icon: 'truck' as const,
    title: 'Entrega e retirada',
    text: 'Levamos até a obra e buscamos no fim.',
  },
];
---

<section aria-label="Diferenciais">
  <ul class="mx-auto grid max-w-[1200px] gap-6 px-4 py-10 sm:grid-cols-2 md:grid-cols-4 md:px-6">
    {items.map((item) => (
      <li class="group flex gap-4" data-reveal>
        <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-[12px] bg-gradient-to-br from-brand-50 to-brand-300/60 text-ink-900 shadow-[0_8px_20px_-12px_rgba(245,184,0,.8)] transition duration-300 group-hover:-rotate-6 group-hover:scale-110 group-hover:shadow-[0_12px_28px_-10px_rgba(245,184,0,.9)]">
          <Icon name={item.icon} class="size-6" />
        </span>
        <div>
          <h2 class="text-base font-bold text-ink-900">{item.title}</h2>
          <p class="text-sm text-ink-500">{item.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
