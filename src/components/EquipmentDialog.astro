---
import { Picture } from 'astro:assets';
import { getCategoryLabel, type Equipment } from '../data/equipment';
import { findPhoto } from '../lib/photos';
import { buildWhatsAppLink, equipmentMessage } from '../lib/whatsapp';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  item: Equipment;
}
const { item } = Astro.props;
const photo = findPhoto(item.photoFile);
const titleId = `${item.id}-titulo`;
---

<dialog
  id={item.id}
  class="m-auto w-[min(960px,calc(100vw-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-[12px] border-0 bg-white p-0 text-ink-900 shadow-2xl backdrop:bg-black/70"
  aria-labelledby={titleId}
  data-dialog
>
  <div class="grid gap-6 p-6 md:grid-cols-2 md:p-8">
    <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-[12px] bg-ink-100 p-4">
      {photo ? (
        <Picture
          src={photo}
          formats={['avif', 'webp']}
          alt={item.name}
          widths={[480, 800]}
          sizes="(min-width: 768px) 40vw, 90vw"
          loading="lazy"
          class="h-full w-full object-contain"
        />
      ) : (
        <span class="text-sm font-semibold text-ink-500">Foto em breve</span>
      )}
    </div>
    <div class="flex flex-col gap-5">
      <div class="flex items-start justify-between gap-4">
        <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-ink-500">
          {getCategoryLabel(item.category)}
        </p>
        <button
          type="button"
          class="-mr-2 -mt-2 inline-flex size-12 shrink-0 items-center justify-center rounded-[12px] hover:bg-ink-100"
          aria-label="Fechar detalhes"
          data-dialog-close
        >
          <Icon name="close" class="size-6" />
        </button>
      </div>
      <h2
        id={titleId}
        tabindex="-1"
        data-dialog-title
        class="condensed text-[clamp(1.5rem,3vw,2rem)] font-extrabold leading-tight"
      >
        {item.name}
      </h2>
      <p class="max-w-[65ch] text-ink-500">{item.description}</p>
      <div>
        <h3 class="mb-2 text-base font-bold">Especificações</h3>
        <ul class="flex flex-col gap-2">
          {item.specs.map((spec) => (
            <li class="flex gap-2 rounded-[8px] bg-ink-50 px-3 py-2 text-ink-900">{spec}</li>
          ))}
        </ul>
      </div>
      <div class="mt-auto pt-2">
        <Button href={buildWhatsAppLink(equipmentMessage(item.name))} icon="whatsapp" external>
          Orçar no WhatsApp
        </Button>
      </div>
    </div>
  </div>
</dialog>
