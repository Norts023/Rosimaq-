---
interface Props {
  /** Cor de cima (CSS). */
  from: string;
  /** Cor de baixo (CSS). */
  to: string;
  height?: string;
}
// Faixa de degradê entre duas seções: troca a quebra seca por uma transição suave.
const { from, to, height = '5rem' } = Astro.props;
---

<div
  aria-hidden="true"
  class="pointer-events-none w-full"
  style={`height:${height};background:linear-gradient(180deg, ${from} 0%, ${to} 100%)`}
></div>
