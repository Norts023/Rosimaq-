---
import { absoluteUrl, withBase } from '../lib/url';
import { company } from '../data/company';

interface Props {
  title: string;
  description: string;
  /** Caminho da página, começando com "/". */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
// Base vem de astro.config (site). Nunca escrever o domínio fixo aqui.
const canonical = absoluteUrl(path, Astro.site);
const image = absoluteUrl('/og-image.jpg', Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={company.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Logo da Rosimaq, locação de equipamentos para construção civil"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#111111" />
<link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
