---
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import Button from './Button.astro';
---

<section
  class="mx-auto max-w-[1200px] px-4 py-[clamp(4rem,10vw,8rem)] md:px-6"
  aria-labelledby="cta-title"
>
  <div class="flex flex-col items-start justify-between gap-8 rounded-[12px] bg-brand-500 p-8 text-ink-900 md:flex-row md:items-center md:p-12">
    <div class="flex flex-col gap-3">
      <!-- APROVAR TEXTO -->
      <h2 id="cta-title" class="condensed text-[clamp(1.75rem,3.5vw,2.75rem)] font-extrabold">
        Precisa de um equipamento hoje?
      </h2>
      <p class="max-w-[65ch] text-ink-900/80">Chame a Rosimaq no WhatsApp e receba o orçamento.</p>
    </div>
    <Button href={buildWhatsAppLink(GENERAL_MESSAGE)} icon="whatsapp" external variant="dark">
      Chamar no WhatsApp
    </Button>
  </div>
</section>
