import { company } from '../../data/company';
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../../lib/whatsapp';

// Só os canais que existem nos dados da empresa. LinkedIn e YouTube não estão cadastrados.
const items = [
  { key: 'insta', label: 'Instagram', href: company.instagram },
  { key: 'whats', label: 'WhatsApp', href: buildWhatsAppLink(GENERAL_MESSAGE) },
];
---

<div class="ui-social">
  {items.map((item) => (
    <a
      class:list={['ui-social__item', `ui-social__item--${item.key}`]}
      href={item.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={item.label}
    >
      <span class="ui-social__tip" aria-hidden="true">
        {item.label}
      </span>
      <span class="ui-social__icon" aria-hidden="true">
        {item.key === 'insta' ? (
          <svg viewBox="0 0 24 24" fill="none" width="26" xmlns="http://www.w3.org/2000/svg">
            <path
              clip-rule="evenodd"
              d="M3 8a5 5 0 0 1 5-5h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8Zm5-3a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H8Zm7.597 2.214a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2h-.01a1 1 0 0 1-1-1ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-5 3a5 5 0 1 1 10 0 5 5 0 0 1-10 0Z"
              fill-rule="evenodd"
              fill="currentColor"
            ></path>
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" width="26" xmlns="http://www.w3.org/2000/svg">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M18.403 5.633A8.919 8.919 0 0 0 12.053 3c-4.948 0-8.976 4.027-8.978 8.977 0 1.582.413 3.126 1.198 4.488L3 21.116l4.759-1.249a8.981 8.981 0 0 0 4.29 1.093h.004c4.947 0 8.975-4.027 8.977-8.977a8.926 8.926 0 0 0-2.627-6.35m-6.35 13.812h-.003a7.446 7.446 0 0 1-3.798-1.041l-.272-.162-2.824.741.753-2.753-.177-.282a7.448 7.448 0 0 1-1.141-3.971c.002-4.114 3.349-7.461 7.465-7.461a7.413 7.413 0 0 1 5.275 2.188 7.42 7.42 0 0 1 2.183 5.279c-.002 4.114-3.349 7.462-7.461 7.462m4.093-5.589c-.225-.113-1.327-.655-1.533-.73-.205-.075-.354-.112-.504.112s-.58.729-.711.879-.262.168-.486.056-.947-.349-1.804-1.113c-.667-.595-1.117-1.329-1.248-1.554s-.014-.346.099-.458c.101-.1.224-.262.336-.393.112-.131.149-.224.224-.374s.038-.281-.019-.393c-.056-.113-.505-1.217-.692-1.666-.181-.435-.366-.377-.504-.383a9.65 9.65 0 0 0-.429-.008.826.826 0 0 0-.599.28c-.206.225-.785.767-.785 1.871s.804 2.171.916 2.321c.112.15 1.582 2.415 3.832 3.387.536.231.954.369 1.279.473.537.171 1.026.146 1.413.089.431-.064 1.327-.542 1.514-1.066.187-.524.187-.973.131-1.067-.056-.094-.207-.151-.43-.263"
              fill="currentColor"
            ></path>
          </svg>
        )}
      </span>
    </a>
  ))}
</div>

<style>
  .ui-social {
    position: relative;
    display: inline-flex;
    justify-content: flex-start;
    gap: 16px;
    padding-top: 40px;
    align-items: center;
  }
  .ui-social__item {
    position: relative;
    display: inline-flex;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(17, 17, 17, 0.12),
      0 6px 16px -10px rgba(17, 17, 17, 0.4);
    cursor: pointer;
    overflow: visible;
    align-items: center;
    justify-content: center;
    color: #0c0c0c;
    transition: color 0.3s ease;
    outline-offset: 4px;
  }
  .ui-social__icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    overflow: hidden;
  }
  .ui-social__icon::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    border-radius: 50%;
    transform: rotateX(360deg);
    transition: height 0.3s ease;
    z-index: -1;
  }
  .ui-social__item:hover,
  .ui-social__item:focus-visible {
    color: #fff;
    box-shadow: 5px 5px 10px #181717ce;
  }
  .ui-social__item:hover .ui-social__icon::before,
  .ui-social__item:focus-visible .ui-social__icon::before {
    height: 100%;
  }
  .ui-social__item--insta .ui-social__icon::before {
    background: linear-gradient(40deg, #0000ff, #f56040);
  }
  .ui-social__item--whats .ui-social__icon::before {
    background: #25d366;
  }
  .ui-social__tip {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%) scale(0);
    font-size: 12px;
    color: #fff;
    border-radius: 3px;
    padding: 3px 6px;
    white-space: nowrap;
    transition: transform 0.3s ease;
  }
  .ui-social__item:hover .ui-social__tip,
  .ui-social__item:focus-visible .ui-social__tip {
    transform: translateX(-50%) scale(1);
  }
  .ui-social__item--insta .ui-social__tip {
    background: linear-gradient(30deg, #0000ff, #f56040);
  }
  .ui-social__item--whats .ui-social__tip {
    background: #25d366;
  }
</style>
