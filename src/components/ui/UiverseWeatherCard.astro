interface Props {
  /** Condição do tempo, por exemplo "Nublado". Os dados são sempre passados por quem usa o componente. */
  condition: string;
  location: string;
  date: string;
  temperature: string;
  forecast: { day: string; temperature: string }[];
}
const { condition, location, date, temperature, forecast } = Astro.props;
---

<article class="ui-weather" aria-label={`Previsão: ${condition}, ${temperature}, ${location}`}>
  <section class="ui-weather__scene" aria-hidden="true">
    <div class="ui-weather__sky"></div>
    <div class="ui-weather__sun"></div>
    <div class="ui-wc__hill-1"></div>
    <div class="ui-wc__hill-2"></div>
    <div class="ui-weather__ocean">
      <div class="ui-weather__reflection"></div>
      <div class="ui-weather__reflection"></div>
      <div class="ui-weather__reflection"></div>
      <div class="ui-weather__reflection"></div>
      <div class="ui-weather__reflection"></div>
      <div class="ui-wc__shadow-1"></div>
      <div class="ui-wc__shadow-2"></div>
    </div>
    <div class="ui-wc__hill-3"></div>
    <div class="ui-wc__hill-4"></div>
    <div class="ui-wc__tree ui-wc__tree-1"></div>
    <div class="ui-wc__tree ui-wc__tree-2"></div>
    <div class="ui-wc__tree ui-wc__tree-3"></div>
    <div class="ui-weather__filter"></div>
  </section>

  <div class="ui-weather__info">
    <div class="ui-weather__left">
      <svg
        class="ui-weather__icon"
        stroke="#000000"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-width="1.5"
          stroke="#ffffff"
          d="M22 14.3529C22 17.4717 19.4416 20 16.2857 20H11M14.381 9.02721C14.9767 8.81911 15.6178 8.70588 16.2857 8.70588C16.9404 8.70588 17.5693 8.81468 18.1551 9.01498M7.11616 11.6089C6.8475 11.5567 6.56983 11.5294 6.28571 11.5294C3.91878 11.5294 2 13.4256 2 15.7647C2 18.1038 3.91878 20 6.28571 20H7M7.11616 11.6089C6.88706 10.9978 6.7619 10.3369 6.7619 9.64706C6.7619 6.52827 9.32028 4 12.4762 4C15.4159 4 17.8371 6.19371 18.1551 9.01498M7.11616 11.6089C7.68059 11.7184 8.20528 11.9374 8.66667 12.2426M18.1551 9.01498C18.8381 9.24853 19.4623 9.60648 20 10.0614"
        ></path>
      </svg>
      <p>{condition}</p>
    </div>
    <div class="ui-weather__right">
      <div class="ui-weather__location">
        <span>{location}</span>
      </div>
      <p>{date}</p>
      <p class="ui-weather__temperature">{temperature}</p>
    </div>
  </div>

  <section class="ui-weather__content">
    <ul class="ui-weather__forecast">
      {forecast.map((item, i) => (
        <>
          {i > 0 && <li class="ui-weather__separator" aria-hidden="true"></li>}
          <li class="ui-weather__day">
            <p>{item.day}</p>
            <p>{item.temperature}</p>
          </li>
        </>
      ))}
    </ul>
  </section>
</article>

<style>
  .ui-weather {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    width: 220px;
    height: 350px;
    max-width: 100%;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 12px 12px 0px rgba(0, 0, 0, 0.1);
    background-color: white;
  }
  .ui-weather__scene {
    position: relative;
    width: 100%;
    height: 70%;
    overflow: hidden;
  }
  .ui-weather__scene > * {
    position: absolute;
  }
  .ui-weather__sky {
    width: 100%;
    height: 100%;
    background: linear-gradient(0deg, rgba(247, 225, 87, 1) 0%, rgba(233, 101, 148, 1) 100%);
  }
  .ui-weather__sun {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background-color: white;
    bottom: 40%;
    left: 23%;
    filter: drop-shadow(0px 0px 10px white);
  }
  .ui-weather__sun::after,
  .ui-weather__sun::before {
    position: absolute;
    content: '';
    border-radius: 50%;
    background-color: white;
  }
  .ui-weather__sun::after {
    width: 118%;
    height: 118%;
    opacity: 0.5;
  }
  .ui-weather__sun::before {
    width: 134%;
    height: 134%;
    opacity: 0.1;
  }
  .ui-weather__ocean {
    overflow: hidden;
    bottom: 0;
    width: 100%;
    height: 28%;
    background: linear-gradient(0deg, rgba(241, 192, 125, 1) 0%, rgba(247, 218, 150, 1) 100%);
  }
  .ui-weather__reflection {
    position: absolute;
    background-color: white;
    opacity: 0.5;
    z-index: 1;
  }
  .ui-weather__ocean .ui-weather__reflection:nth-child(1) {
    width: 40px;
    height: 10px;
    clip-path: polygon(0% 0%, 100% 0%, 50% 20%);
    top: 5%;
    left: 32%;
  }
  .ui-weather__ocean .ui-weather__reflection:nth-child(2) {
    width: 80px;
    height: 15px;
    clip-path: polygon(0% 0%, 100% 0%, 60% 20%, 40% 20%);
    top: 15%;
    left: 39%;
  }
  .ui-weather__ocean .ui-weather__reflection:nth-child(3) {
    width: 60px;
    height: 2px;
    clip-path: polygon(0% 50%, 40% 0%, 60% 0%, 100% 50%, 60% 100%, 40% 100%);
    top: 27%;
    right: 15%;
  }
  .ui-weather__ocean .ui-weather__reflection:nth-child(4) {
    width: 70px;
    height: 2px;
    clip-path: polygon(0% 50%, 40% 0%, 60% 0%, 100% 50%, 60% 100%, 40% 100%);
    top: 37%;
    right: 28%;
  }
  .ui-weather__ocean .ui-weather__reflection:nth-child(5) {
    width: 70px;
    height: 3px;
    clip-path: polygon(0% 50%, 40% 0%, 60% 0%, 100% 50%, 60% 100%, 40% 100%);
    top: 46%;
    right: 8%;
  }
  .ui-wc__hill-1 {
    right: -25%;
    bottom: 20%;
    width: 150px;
    height: 40px;
    border-radius: 50%;
    background-color: #e6b29d;
  }
  .ui-wc__shadow-1 {
    right: -25%;
    top: -30%;
    width: 150px;
    height: 40px;
    border-radius: 50%;
    background-color: #f1c7a0;
  }
  .ui-wc__hill-2 {
    right: -36%;
    bottom: 10%;
    width: 150px;
    height: 80px;
    border-radius: 50%;
    background-color: #c29182;
  }
  .ui-wc__shadow-2 {
    right: -36%;
    top: -65%;
    width: 150px;
    height: 80px;
    border-radius: 50%;
    background-color: #e5bb96;
  }
  .ui-wc__hill-3 {
    left: -100%;
    bottom: -28%;
    width: 350px;
    height: 150px;
    border-radius: 50%;
    background-color: #b77873;
    z-index: 3;
  }
  .ui-wc__hill-4 {
    right: -100%;
    bottom: -40%;
    width: 350px;
    height: 150px;
    border-radius: 50%;
    background-color: #a16773;
    z-index: 3;
  }
  .ui-wc__tree {
    z-index: 3;
    border-radius: 50% 50% 45% 45%;
  }
  .ui-wc__tree-1 {
    bottom: 20%;
    left: 3%;
    width: 50px;
    height: 70px;
    background-color: #b77873;
  }
  .ui-wc__tree-2 {
    bottom: 14%;
    left: 25%;
    width: 50px;
    height: 70px;
    background-color: #b77873;
  }
  .ui-wc__tree-3 {
    bottom: 10%;
    right: 1%;
    width: 65px;
    height: 80px;
    background-color: #a16773;
  }
  .ui-weather__filter {
    height: 100%;
    width: 100%;
    background: linear-gradient(0deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 40%);
    z-index: 5;
    opacity: 0.2;
  }
  .ui-weather__content {
    position: relative;
    width: 100%;
    height: 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ui-weather__info {
    display: flex;
    align-items: center;
    justify-content: space-around;
    position: absolute;
    text-align: center;
    top: 0;
    left: 0;
    width: 100%;
    padding-top: 15px;
    color: white;
    z-index: 10;
  }
  .ui-weather__left {
    width: 20%;
    font-size: 11pt;
    font-weight: 600;
    align-self: baseline;
  }
  .ui-weather__left p {
    margin: 0;
  }
  .ui-weather__icon {
    display: block;
    width: 40px;
    margin: 0 auto;
  }
  .ui-weather__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .ui-weather__right > p:nth-child(2) {
    font-size: 9pt;
    margin: 0;
    padding: 0;
  }
  .ui-weather__location {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
  }
  .ui-weather__location span {
    font-size: 11pt;
    font-weight: 700;
    text-transform: uppercase;
  }
  .ui-weather__temperature {
    font-size: 20pt;
    font-weight: 700;
    line-height: 30px;
    margin: 0;
  }
  .ui-weather__forecast {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    height: 100%;
    width: 100%;
    padding: 10px 25px;
    list-style: none;
    margin: 0;
  }
  .ui-weather__day {
    box-sizing: border-box;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: lightslategray;
    font-size: 9pt;
  }
  .ui-weather__forecast p {
    margin: 0;
  }
  .ui-weather__separator {
    width: 100%;
    height: 2px;
    background-color: rgb(233, 233, 233);
    border-radius: 1px;
  }
</style>
