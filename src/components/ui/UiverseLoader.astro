interface Props {
  /** Texto para leitores de tela. */
  label?: string;
}
const { label = 'Carregando' } = Astro.props;
---

<div class="ui-loader" role="status" aria-label={label}>
  <div class="ui-loader__dot"></div>
  <div class="ui-loader__dot"></div>
  <div class="ui-loader__dot"></div>
  <div class="ui-loader__dot"></div>
</div>

<style>
  .ui-loader {
    --uib-size: 50px;
    --uib-speed: 1.2s;
    --uib-color: #474554;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--uib-size);
    height: var(--uib-size);
  }

  .ui-loader__dot {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    width: 25%;
    transform-origin: center top;
  }

  .ui-loader__dot::after {
    content: '';
    display: block;
    width: 100%;
    height: 25%;
    border-radius: 50%;
    background-color: var(--uib-color);
  }

  .ui-loader__dot:first-child {
    animation: ui-swing var(--uib-speed) linear infinite;
  }

  .ui-loader__dot:last-child {
    animation: ui-swing2 var(--uib-speed) linear infinite;
  }

  @keyframes ui-swing {
    0% {
      transform: rotate(0deg);
      animation-timing-function: ease-out;
    }
    25% {
      transform: rotate(70deg);
      animation-timing-function: ease-in;
    }
    50% {
      transform: rotate(0deg);
      animation-timing-function: linear;
    }
  }

  @keyframes ui-swing2 {
    0% {
      transform: rotate(0deg);
      animation-timing-function: linear;
    }
    50% {
      transform: rotate(0deg);
      animation-timing-function: ease-out;
    }
    75% {
      transform: rotate(-70deg);
      animation-timing-function: ease-in;
    }
  }
</style>
