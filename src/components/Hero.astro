---
import { withBase } from '../lib/url';
import { Picture } from 'astro:assets';
import { photoFor } from '../lib/photos';
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import Button from './Button.astro';

const whatsapp = buildWhatsAppLink(GENERAL_MESSAGE);
// Títulos aprovados para o topo. Cada um tem a parte branca e a parte amarela.
const titles = [
  { lead: 'Equipamento certo.', accent: 'Obra andando.' },
  { lead: 'Sua obra', accent: 'não para.' },
  { lead: 'Locação que', accent: 'chega na hora.' },
];
const cards = [
  {
    file: '01_Betoneira_Menegotti_Prime_400L_220V.jpg',
    label: 'Betoneira 400 L',
    rotate: '-6deg',
    depth: 1,
    eager: true,
  },
  {
    file: '02_Martelete_Rompedor_Arita_5kg_1300W_220V.jpg',
    label: 'Martelete rompedor 5 kg',
    rotate: '4deg',
    depth: 1.4,
    eager: false,
  },
  {
    file: '06_Andaime_Profissional_Aco_1,00x1,00_NR18.jpg',
    label: 'Andaime de aço 1,00 x 1,00',
    rotate: '-2deg',
    depth: 0.7,
    eager: false,
  },
];
---

<!-- APROVAR TEXTO: alternativas para o título, escolha uma e apague as outras.
  - "SUA OBRA NÃO PARA."
  - "LOCAÇÃO QUE CHEGA NA HORA." -->
<section
  class="relative isolate overflow-hidden bg-ink-900 text-white"
  data-hero
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: var(--gradient-spotlight), var(--color-ink-900);"
    aria-hidden="true"
  ></div>
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-4 pb-20 pt-16 md:grid-cols-[1.25fr_0.75fr] md:px-6 md:pb-28 md:pt-24">
    <div class="flex flex-col gap-7">
      <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-brand-300">
        Santana de Parnaíba e região
      </p>
      <h1
        id="hero-title"
        class="condensed text-[clamp(2.75rem,8vw,7rem)] font-black leading-[.92] tracking-[-0.01em]"
      >
        {titles.map((t, i) => (
          <span class="hero-phrase" data-phrase={i} hidden={i !== 0}>
            {t.lead} <span class="text-brand-500">{t.accent}</span>
          </span>
        ))}
      </h1>
      <div class="hero-controls flex items-center gap-4" hidden>
        <div class="flex gap-2" role="group" aria-label="Escolher o título do topo">
          {titles.map((t, i) => (
            <button
              type="button"
              class="hero-dot size-11 inline-flex items-center justify-center rounded-full"
              data-dot={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`Mostrar título ${i + 1}: ${t.lead} ${t.accent}`}
            >
              <span class="hero-dot__mark" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <button
          type="button"
          class="hero-pause text-sm font-semibold text-ink-300 underline underline-offset-4 hover:text-white"
          data-pause
          aria-pressed="false"
        >
          Pausar títulos
        </button>
      </div>
      <p class="max-w-[65ch] text-lg text-ink-300">
        Locação de betoneira, martelete, andaime e mais equipamentos para a sua obra. Peça o
        orçamento em minutos pelo WhatsApp.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={whatsapp} icon="whatsapp" external>
          Pedir orçamento no WhatsApp
        </Button>
        <Button href={withBase('/equipamentos')} variant="secondary" icon="arrow">
          Ver equipamentos
        </Button>
      </div>
    </div>

    <div
      class="relative h-[360px] md:h-[440px]"
      data-hero-cards
      style="transform: translate3d(var(--px,0px), var(--py,0px), 0);"
    >
      {cards.map((card, i) => (
        <div
          class="float-y pointer-events-none absolute inset-0"
          style={`--float-delay:-${i * 2.2}s;z-index:${i === 1 ? 3 : 2}`}
        >
          <figure
            class="hero-card absolute left-1/2 top-1/2 overflow-hidden rounded-[12px] bg-white shadow-[0_30px_60px_-30px_rgba(0,0,0,.6)]"
            style={`--dx:${i - 1};--dy:${(i === 1 ? -6 : 4) * card.depth};--rot:${card.rotate};z-index: ${i === 1 ? 3 : 2}`}
          >
            <Picture
              src={photoFor(card.file)}
              formats={['avif', 'webp']}
              alt={card.label}
              widths={[320, 480]}
              sizes="(min-width: 768px) 25vw, 60vw"
              loading={card.eager ? 'eager' : 'lazy'}
              fetchpriority={card.eager ? 'high' : 'auto'}
              class="aspect-[4/3] w-full object-contain p-3"
            />
            <figcaption class="bg-gradient-to-r from-brand-50 to-white px-3 py-2 text-xs font-semibold uppercase tracking-[.06em] text-ink-900">
              {card.label}
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Cards do hero: deslocamento lateral menor no celular para não sair da tela. */
  .hero-card {
    width: 46%;
    transform: translate(calc(-50% + var(--dx) * 16%), calc(-50% + var(--dy) * 1%))
      rotate(var(--rot));
  }
  @media (min-width: 768px) {
    .hero-card {
      width: 52%;
      transform: translate(calc(-50% + var(--dx) * 24%), calc(-50% + var(--dy) * 1%))
        rotate(var(--rot));
    }
  }
  .hero-phrase:not([hidden]) {
    display: inline;
    animation: phrase-in 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero-phrase[hidden] {
    display: none;
  }
  .hero-dot__mark {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.3);
    transition:
      background 300ms ease,
      transform 300ms ease;
  }
  .hero-dot[aria-pressed='true'] .hero-dot__mark {
    background: var(--color-brand-500);
    transform: scale(1.25);
  }
  @keyframes phrase-in {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-phrase:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { initSpotlight } from '../lib/spotlight';

  const INTERVAL_MS = 6000;
  let timer: number | undefined;

  function initRotator(section: HTMLElement): void {
    const phrases = Array.from(section.querySelectorAll<HTMLElement>('.hero-phrase'));
    const dots = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const controls = section.querySelector<HTMLElement>('.hero-controls');
    const pause = section.querySelector<HTMLButtonElement>('[data-pause]');
    if (phrases.length < 2 || !controls || !pause) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let paused = reduce;
    let hovering = false;

    const show = (next: number) => {
      index = next;
      phrases.forEach((el, i) => {
        el.hidden = i !== index;
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === index)));
    };

    const setPaused = (value: boolean) => {
      paused = value;
      pause.setAttribute('aria-pressed', String(value));
      pause.textContent = value ? 'Continuar títulos' : 'Pausar títulos';
    };

    // Sem JavaScript os controles ficam ocultos; com JavaScript aparecem.
    controls.hidden = false;
    if (reduce) {
      pause.hidden = true;
    }
    setPaused(paused);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.dot));
      });
    });

    pause.addEventListener('click', () => setPaused(!paused));

    section.addEventListener('pointerenter', () => {
      hovering = true;
    });
    section.addEventListener('pointerleave', () => {
      hovering = false;
    });

    // Um único temporizador por vez: a navegação recria o hero.
    if (timer !== undefined) window.clearInterval(timer);
    timer = window.setInterval(() => {
      if (paused || hovering) return;
      show((index + 1) % phrases.length);
    }, INTERVAL_MS);
  }

  // Reinicia a cada página (View Transitions), sem duplicar listeners.
  function initHero(): void {
    document.querySelectorAll<HTMLElement>('[data-hero]').forEach((section) => {
      if (section.dataset.ready === 'on') return;
      section.dataset.ready = 'on';
      initSpotlight(section);
      initRotator(section);
    });
  }
  document.addEventListener('astro:page-load', initHero);
  initHero();
</script>
