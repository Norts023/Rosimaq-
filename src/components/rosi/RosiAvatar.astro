---
// Avatar original da Rosi: rosto simples com capacete de obra amarelo. Desenho próprio, em SVG.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="30" fill="#FFF8DB" stroke="#111111" stroke-width="2" />
  <path
    d="M14 28a18 18 0 0 1 36 0z"
    fill="#F5B800"
    stroke="#111111"
    stroke-width="2"
    stroke-linejoin="round"
  />
  <rect
    x="10"
    y="27"
    width="44"
    height="5"
    rx="2.5"
    fill="#F5B800"
    stroke="#111111"
    stroke-width="2"
  />
  <circle cx="25" cy="38" r="2.5" fill="#111111" />
  <circle cx="39" cy="38" r="2.5" fill="#111111" />
  <path d="M26 46q6 5 12 0" fill="none" stroke="#111111" stroke-width="2" stroke-linecap="round" />
</svg>
