---
import { company } from '../data/company';
import { buildWhatsAppLink, GENERAL_MESSAGE } from '../lib/whatsapp';
import Button from './Button.astro';
---

<section class="bg-ink-100 py-[clamp(4rem,10vw,8rem)]" aria-labelledby="regioes-title">
  <div class="mx-auto grid max-w-[1200px] gap-10 px-4 md:grid-cols-[1fr_1.2fr] md:px-6">
    <div class="flex flex-col gap-5">
      <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-ink-500">
        Onde atendemos
      </p>
      <!-- APROVAR TEXTO -->
      <h2 id="regioes-title" class="condensed text-[clamp(1.75rem,3.5vw,2.75rem)] font-extrabold">
        Atendemos sua obra em
      </h2>
      <p class="max-w-[65ch] text-ink-500">Está em outra cidade? Consulte pelo WhatsApp.</p>
      <div class="mt-2">
        <Button href={buildWhatsAppLink(GENERAL_MESSAGE)} icon="whatsapp" external>
          Consultar minha cidade
        </Button>
      </div>
    </div>
    <ul class="flex flex-wrap content-start gap-3" aria-label="Municípios atendidos">
      {company.serviceArea.map((city) => (
        <li class="cursor-default rounded-[999px] border border-ink-300 bg-white px-5 py-3 text-lg font-bold text-ink-900 transition duration-300 hover:-translate-y-1 hover:border-brand-500 hover:bg-brand-500 hover:shadow-[0_10px_24px_-14px_rgba(0,0,0,.4)]">
          {city}
        </li>
      ))}
    </ul>
  </div>
</section>
