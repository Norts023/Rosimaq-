---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  mainStyle="background: var(--gradient-page-light)"
  title="Página não encontrada | Rosimaq"
  description="Esta página não existe. Veja o catálogo ou volte ao início."
  path="/404"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>
  <section
    class="relative isolate flex min-h-[70dvh] items-center overflow-hidden text-ink-900"
    style="background: var(--gradient-spotlight-light);"
  >
    <div class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 py-20 md:px-6">
      <p class="text-[0.8125rem] font-semibold uppercase tracking-[.08em] text-ink-500">Erro 404</p>
      <h1 class="condensed text-[clamp(2.25rem,6vw,5rem)] font-black leading-[.95]">
        Esse equipamento saiu para obra
      </h1>
      <p class="max-w-[65ch] text-lg text-ink-500">
        O endereço que você abriu não existe mais ou mudou de lugar.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={withBase('/')} icon="arrow">
          Ir para o início
        </Button>
        <Button href={withBase('/equipamentos')} variant="outline" icon="arrow">
          Ver equipamentos
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
